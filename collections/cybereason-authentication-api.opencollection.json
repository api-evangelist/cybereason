{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cybereason Authentication API",
    "version": "23.x"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "JSESSIONID",
      "value": "{{JSESSIONID}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Log in and obtain a JSESSIONID cookie",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.cybereason.net/login.html",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "username",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Log in and obtain a JSESSIONID cookie"
        },
        {
          "info": {
            "name": "Log out the current session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.cybereason.net/logout"
          },
          "docs": "Log out the current session"
        }
      ]
    }
  ],
  "bundled": true
}