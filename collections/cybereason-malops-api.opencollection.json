{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cybereason Authentication Malops API",
    "version": "23.x"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "JSESSIONID",
      "value": "{{JSESSIONID}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Malops",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query the Malop inbox",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.cybereason.net/rest/detection/inbox",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Query the Malop inbox"
        },
        {
          "info": {
            "name": "Query unified Malops",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.cybereason.net/rest/crimes/unified",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Query unified Malops"
        }
      ]
    }
  ],
  "bundled": true
}